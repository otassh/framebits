# Copy to .env and fill in. Never commit .env (chmod 600 .env).
# Generate secrets with `openssl rand -base64 <n>` (never reuse across hosts).
# Example: openssl rand -base64 32  # POSTGRES_PASSWORD
#          openssl rand -base64 48  # ADMIN_TOKEN / LIKE_PEPPER
DATABASE_URL=postgres://framebits:changeme@localhost:5432/framebits
ADMIN_TOKEN=change-me-to-at-least-32-chars-long-secret-token
WEB_ORIGIN=http://localhost:3000
REGISTRY_URL=https://framebits.dev/r
VITE_REGISTRY_URL=/r
# 1 direct on the VPS (Caddy -> api, one hop); 2 behind Cloudflare/CDN in front
# of Caddy (client -> CDN -> Caddy -> api). Never trust more hops than deployed.
TRUSTED_PROXY_COUNT=1
LIKE_PEPPER=change-me-like-pepper-secret
PORT=3001
