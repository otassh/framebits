{
  "name": "algorithco-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "algorithco-ui": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "pnpm build && pnpm pack --pack-destination ./dist-pack",
    "smoke": "node scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@algorithco-ui/builder": "workspace:*",
    "@algorithco-ui/config": "workspace:*",
    "@algorithco-ui/shared": "workspace:*",
    "@clack/prompts": "^1.8.1",
    "@types/node": "^22.20.5",
    "commander": "^15.0.0",
    "eslint": "^9.14.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
