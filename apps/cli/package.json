{
  "name": "framebits",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Add curated animated React components to your project",
  "keywords": [
    "framebits",
    "react",
    "components",
    "animations",
    "tailwind",
    "cli"
  ],
  "homepage": "https://github.com/otassh/framebits#readme",
  "bugs": {
    "url": "https://github.com/otassh/framebits/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otassh/framebits.git",
    "directory": "apps/cli"
  },
  "author": "otassh",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "framebits": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "node scripts/copy-license.mjs",
    "prepublishOnly": "npm run build && node scripts/pack-smoke.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "pack": "pnpm build && pnpm pack --pack-destination ./dist-pack",
    "smoke": "node scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@framebits/builder": "workspace:*",
    "@framebits/config": "workspace:*",
    "@framebits/shared": "workspace:*",
    "@clack/prompts": "^1.8.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.20.5",
    "commander": "^15.0.0",
    "eslint": "^9.14.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "cross-spawn": "7.0.6"
  }
}
