{
  "name": "@framebits/web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare-registry": "pnpm --filter @framebits/builder build:registry --out ../../apps/web/.registry --archive-dir ../../apps/web/.registry-archive",
    "predev": "pnpm run prepare-registry",
    "dev": "vite",
    "prebuild": "pnpm run prepare-registry",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@framebits/shared": "workspace:*",
    "@react-three/fiber": "9.8.1",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@framebits/builder": "workspace:*",
    "@framebits/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  }
}
