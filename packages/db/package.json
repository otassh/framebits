{
  "name": "@framebits/db",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsup src/index.ts --format esm --dts --clean",
    "db:migrate": "tsx --env-file=../../.env src/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/check-postgres.mjs"
  },
  "devDependencies": {
    "@framebits/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "^9.14.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
